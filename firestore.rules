rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    function hasActiveSubscription() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active';
    }
    
    function hasProTier() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionTier in ['pro-monthly', 'pro-annual'];
    }
    
    // ============================================
    // STUDIO / LAYOUTS COLLECTION
    // ============================================
    
    match /layouts/{layoutId} {
      // Anyone can read layouts (for homepage rendering)
      allow read: if true;
      // Only authenticated users can write layouts (Studio editing)
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile on signup
      allow create: if isOwner(userId) && 
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email;
      
      // Users can update their own profile (except protected fields)
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'referralEarnings',
          'totalReferrals',
          'subscriptionStatus'
        ]);
      
      // Prevent user deletion (use soft delete instead)
      allow delete: if false;
    }
    
    // ============================================
    // RESUMES COLLECTION
    // ============================================
    
    match /resumes/{resumeId} {
      // Users can read own resumes, OR anyone can read if shareEnabled
      allow read: if isOwner(resource.data.userId) || 
        (resource.data.shareEnabled == true);
      
      // Users can create resumes (must set themselves as owner)
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update own resumes
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId; // Prevent changing owner
      
      // Users can delete own resumes
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ============================================
    // JOBS COLLECTION (Job Tracker)
    // ============================================
    
    match /jobs/{jobId} {
      // Users can only access their own job applications
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isOwner(resource.data.userId);
      
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ============================================
    // CERTIFICATIONS COLLECTION (Cert Vault)
    // ============================================
    
    match /certifications/{certId} {
      // Users can read own certs, OR anyone with share link
      allow read: if isOwner(resource.data.userId) || 
        (resource.data.shareEnabled == true);
      
      // Users can create certifications
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update own certifications
      allow update: if isOwner(resource.data.userId);
      
      // Users can delete own certifications
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ============================================
    // BLUEPRINTS COLLECTION (Career Paths - $29)
    // ============================================
    
    match /blueprints/{blueprintId} {
      // Anyone can read published blueprints
      // Users who purchased can read unpublished/preview
      allow read: if resource.data.published == true || 
        (isAuthenticated() && request.auth.uid in resource.data.purchasedBy) ||
        isAdmin();
      
      // Only admins can create/update/delete blueprints
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // REFERRALS COLLECTION
    // ============================================
    
    match /referrals/{referralId} {
      // Users can read referrals they created
      allow read: if isOwner(resource.data.referrerId) || isAdmin();
      
      // Users can create referrals
      allow create: if isAuthenticated() && 
        request.resource.data.referrerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Only system/cloud functions can update referrals
      allow update: if false;
      
      // Prevent deletion
      allow delete: if false;
    }
    
    // ============================================
    // SUBSCRIPTIONS COLLECTION
    // ============================================
    
    match /subscriptions/{subscriptionId} {
      // Users can read their own subscriptions
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Only system (Stripe webhooks) can write subscriptions
      allow create, update, delete: if false;
    }
    
    // ============================================
    // TEMPLATES COLLECTION
    // ============================================
    
    match /templates/{templateId} {
      // Anyone can read published templates
      // Pro users can read all templates
      allow read: if resource.data.published == true || 
        resource.data.tier == 'free' ||
        hasProTier() ||
        isAdmin();
      
      // Only admins can manage templates
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // UNLOCKS COLLECTION (Resume PDF Unlocks)
    // ============================================
    
    match /unlocks/{unlockId} {
      // Users can read their own unlocks
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // System creates unlock records
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Prevent updates and deletes
      allow update, delete: if false;
    }
    
    // ============================================
    // ANALYTICS COLLECTION (Optional - for tracking)
    // ============================================
    
    match /analytics/{document=**} {
      // Only admins can read analytics
      allow read: if isAdmin();
      
      // System can write analytics
      allow create: if isAuthenticated();
      
      // Prevent updates and deletes
      allow update, delete: if false;
    }
  }
}
