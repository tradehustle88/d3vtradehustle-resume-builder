{
  "functions": [
    {
      "codebase": "default",
      "source": "api-functions",
      "runtime": "nodejs20"
    },
    {
      "source": "gen2",
      "codebase": "gen2",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "frontend",
      "public": "frontend/out",
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "api",
      "rewrites": [
        {
          "source": "/api/verify-recaptcha",
          "function": "verifyRecaptcha"
        },
        {
          "source": "/api/signup",
          "function": "signup"
        },
        {
          "source": "/api/unlock-resume",
          "function": "unlockResume"
        }
      ]
    }
  ]
}
