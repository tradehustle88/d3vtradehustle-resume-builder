rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Protect unlocks collection - only Admin SDK can write
    match /unlocks/{docId} {
      // Allow reads for authenticated users (optional - for admin dashboard)
      allow read: if isAuthenticated();
      
      // Block all direct client writes - only API route can write via Admin SDK
      allow write: if false;
    }
    
    // Resumes collection - user can only access their own resumes
    match /resumes/{resumeId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Job Applications collection - user can only access their own applications
    match /jobApplications/{applicationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Certifications collection - user can only access their own certifications
    match /certifications/{certId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // User profiles collection - user can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Users cannot delete their own profile
    }
    
    // Blueprint Purchases collection - user can only read their own purchases
    match /blueprintPurchases/{purchaseId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only backend can write purchases
    }
    
    // Blueprint Purchase Attempts collection - user can read their own attempts
    match /blueprintPurchaseAttempts/{attemptId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only backend can write attempts
    }
    
    // Referrals collection - referrer can read their own referrals
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && isOwner(resource.data.referrerId);
      allow write: if false; // Only backend can write referrals
    }
    
    // Payout Requests collection - user can read their own payout requests
    match /payoutRequests/{requestId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only backend can write payout requests
    }
    
    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}