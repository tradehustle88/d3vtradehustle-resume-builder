rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Protect unlocks collection - only Admin SDK can write
    match /unlocks/{docId} {
      // Allow reads for authenticated users (optional - for admin dashboard)
      allow read: if request.auth != null;
      
      // Block all direct client writes - only API route can write via Admin SDK
      allow write: if false;
    }
    
    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}