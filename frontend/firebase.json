{
  "functions": {
    "source": "api-functions",
    "runtime": "nodejs18"
  },
  "hosting": [
    {
      "target": "frontend",
      "public": "frontend/out",
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "api",
      "rewrites": [
        { "source": "/api/verify-recaptcha", "function": "verifyRecaptcha" },
        { "source": "/api/signup", "function": "signup" },
        { "source": "/api/unlock-resume", "function": "unlockResume" }
      ]
    }
  ]
}


