{
  "hosting": [
    {
      "target": "frontend",
      "public": "frontend/out",
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "api",
      "rewrites": [
        { "source": "/signup", "function": "signup" },
        { "source": "/unlock-resume", "function": "unlockResume" }
      ]
    }
  ]
}


